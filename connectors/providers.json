    "ncbi-eutils": {
      "display_name": "NCBI E-utilities",
      "purpose": "Search public biomedical literature and study metadata, resolve NCBI accession.version identifiers, or retrieve bounded public NCBI Taxonomy records.",
      "would_send": [
        "query terms",
        "database name",
        "date and field filters",
        "public accession identifiers",
        "public taxonomy names or TaxIds",
        "pagination parameters"
      ],
      "credential_fields": [],
      "billing": {
        "mode": "public-free",
        "requires_separate_paid_authorization": false,
        "summary": "The shared executor uses anonymous no-key access at the public rate limit; host-managed identity or API keys stay outside this adapter."
      },
      "allowed_hosts": [
        "eutils.ncbi.nlm.nih.gov"
      ],
      "execution": {
        "execution_mode": "direct-read",
        "allowed_url_prefixes": [
          "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/einfo.fcgi",
          "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
          "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi",
          "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi"
        ],
        "rate_limit_per_second": 3,
        "max_response_bytes": 16777216
      },
      "official_docs": "https://www.ncbi.nlm.nih.gov/books/NBK25497/"
    },
